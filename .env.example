# API backend
VITE_BACKEND_URL=/api-proxy

# Stripe — publishable key (Astro requiere prefijo PUBLIC_ para exponer al cliente)
# Si no se setea, src/lib/payment-config.ts usa el fallback pk_live verificada de prod.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx

# Mock products en /tienda/ checkout — solo dev local.
# Si =true, el sidebar muestra dispositivo + envío con datos hardcoded
# cuando el endpoint /api/public/ecommerce/products no responde
# (porque aún no está deployado el backend o no hay productos en CRM).
# IMPORTANTE: dejar SIN setear o =false en build de producción.
PUBLIC_USE_MOCK_PRODUCTS=false
