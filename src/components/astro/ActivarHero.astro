---
import Breadcrumb from './Breadcrumb.astro';
---

<section class="bg-panda-surface py-16">
  <div class="max-w-6xl mx-auto px-4">
    <Breadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Activar' }]} />

    <h1 class="font-unbounded text-3xl sm:text-4xl md:text-5xl font-bold text-panda-dark mb-4">
      Activa, recarga o porta tu línea
    </h1>
    <p class="font-poppins text-lg text-panda-gray max-w-xl mb-8">
      Ingresa tu número o ICCID para comenzar
    </p>

    <!-- Trust Badges -->
    <div class="flex flex-wrap gap-3">
      <span class="bg-white rounded-full px-4 py-2 text-xs font-semibold text-panda-dark shadow-sm border border-gray-100 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-panda-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        Sin cuenta
      </span>
      <span class="bg-white rounded-full px-4 py-2 text-xs font-semibold text-panda-dark shadow-sm border border-gray-100 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-panda-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        2 min máximo
      </span>
      <span class="bg-white rounded-full px-4 py-2 text-xs font-semibold text-panda-dark shadow-sm border border-gray-100 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-panda-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        Pago seguro
      </span>
    </div>
  </div>
</section>
