---

---

<section id="ventajas" class="relative py-14 md:py-20 overflow-hidden">
  <!-- Banner de fondo (manos chocando con celulares, cielo nubes) — del diseño -->
  <div class="absolute inset-0">
    <img
      src="/img/banners/advantages-handshake.webp"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <!-- Overlay claro para que las cards blancas se lean bien — menos fuerte
         para que el banner del diseño se note como decorativo. -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-panda-surface/90 via-panda-surface/52 to-panda-surface/82"
    >
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4">
    <!-- Header -->
    <div class="text-center mb-8">
      <h2
        class="font-unbounded text-3xl sm:text-4xl font-bold text-panda-dark mb-3 drop-shadow-sm"
      >
        ¿Por qué elegir Be Online?
      </h2>
    </div>

    <!-- Cards grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-3xl mx-auto"
    >
      <!-- Card: Precios justos -->
      <div
        class="bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-6 h-6 rounded-md bg-panda-red/10 flex items-center justify-center mb-2.5"
        >
          <svg
            class="w-3.5 h-3.5 text-panda-red"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-xs font-semibold text-panda-dark mb-1.5">
          Precios justos
        </h3>
        <p class="font-poppins text-[11px] text-panda-gray leading-snug">
          Planes accesibles sin costos ocultos ni letra chica
        </p>
      </div>

      <!-- Card: Cobertura nacional -->
      <div
        class="bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-6 h-6 rounded-md bg-panda-red/10 flex items-center justify-center mb-2.5"
        >
          <svg
            class="w-3.5 h-3.5 text-panda-red"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-xs font-semibold text-panda-dark mb-1.5">
          Cobertura nacional
        </h3>
        <p class="font-poppins text-[11px] text-panda-gray mb-1.5 leading-snug">
          La red más grande de México con tecnología 4G LTE
        </p>
        <a
          href="/#cobertura"
          class="font-poppins text-xs font-bold text-panda-red-dark hover:underline"
          >Ver cobertura &rarr;</a
        >
      </div>

      <!-- Card: Sin contratos -->
      <div
        class="bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-6 h-6 rounded-md bg-panda-red/10 flex items-center justify-center mb-2.5"
        >
          <svg
            class="w-3.5 h-3.5 text-panda-red"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-xs font-semibold text-panda-dark mb-1.5">
          Sin contratos
        </h3>
        <p class="font-poppins text-[11px] text-panda-gray leading-snug">
          Libertad total. Recarga cuando quieras, sin permanencia
        </p>
      </div>

      <!-- Card: Redes sociales ilimitadas -->
      <div
        class="bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-6 h-6 rounded-md bg-panda-red/10 flex items-center justify-center mb-2.5"
        >
          <svg
            class="w-3.5 h-3.5 text-panda-red"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-xs font-semibold text-panda-dark mb-1.5">
          Redes sociales ilimitadas
        </h3>
        <p class="font-poppins text-[11px] text-panda-gray leading-snug">
          WhatsApp, Facebook, Instagram y más sin consumir tus datos
        </p>
      </div>

      <!-- Card: Soporte *777 -->
      <div
        class="bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-6 h-6 rounded-md bg-panda-red/10 flex items-center justify-center mb-2.5"
        >
          <svg
            class="w-3.5 h-3.5 text-panda-red"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-xs font-semibold text-panda-dark mb-1.5">
          Soporte *777
        </h3>
        <p class="font-poppins text-[11px] text-panda-gray mb-1.5 leading-snug">
          Atención al cliente desde tu celular, sin costo
        </p>
        <a
          href="tel:*777"
          class="font-poppins text-xs font-bold text-panda-red-dark hover:underline"
          >Llamar ahora &rarr;</a
        >
      </div>

      <!-- Card: App Be Online -->
      <div
        class="bg-white rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow"
      >
        <div
          class="w-6 h-6 rounded-md bg-panda-red/10 flex items-center justify-center mb-2.5"
        >
          <svg
            class="w-3.5 h-3.5 text-panda-red"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-xs font-semibold text-panda-dark mb-1.5">
          App Be Online
        </h3>
        <p class="font-poppins text-[11px] text-panda-gray mb-1.5 leading-snug">
          Gestiona tu línea, recargas y consumo desde la app
        </p>
        <a
          href="/#app"
          class="font-poppins text-xs font-bold text-panda-red-dark hover:underline"
          >Descargar &rarr;</a
        >
      </div>
    </div>
  </div>
</section>
