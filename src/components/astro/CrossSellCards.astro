---
import type { ServiceTab } from "./ServiceSubNav.astro";

interface Props {
  exclude: ServiceTab;
}

const { exclude } = Astro.props;

// Cards wide PSD-match (278x138 ≈ 2:1): solo título + descripción + CTA link.
const allCards: {
  key: ServiceTab;
  title: string;
  description: string;
  href: string;
  cta: string;
}[] = [
  {
    key: "telefonia",
    title: "Telefonía Móvil",
    description:
      "Planes con redes ilimitadas, minutos y datos. Sin contrato.",
    href: "/telefonia-movil/#planes",
    cta: "Ver planes",
  },
  {
    key: "mifi",
    title: "Internet Portátil MiFi",
    description:
      "Wi-Fi de bolsillo, 10 dispositivos, batería todo el día. Para llevar contigo.",
    href: "/internet-portatil/",
    cta: "Ver MiFi",
  },
  {
    key: "cobertura",
    title: "Mapa de Cobertura",
    description:
      "Verifica si tu zona tiene cobertura 4G LTE Be Online antes de comprar.",
    href: "/cobertura/",
    cta: "Ver mapa",
  },
];

const cards = allCards.filter((c) => c.key !== exclude).slice(0, 3);
const isTelefonia = exclude === "telefonia";
---

<section
  class={`relative py-10 md:py-14 overflow-hidden ${isTelefonia ? "bg-[#FFCD54]" : "bg-[#142035]"}`}
>
  <!-- BG telefonia-05 con object-position-left para mantener mano+phone visible a la izquierda -->
  <!--
  <div class="absolute inset-0">
    <img
      src="/img/banners/services/telefonia-05.webp"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover object-center md:object-left opacity-20"
      loading="lazy"
    />
    <div class={`absolute inset-0 ${isTelefonia ? "bg-[#FFCD54]/88" : "bg-[#142035]/60"}`}></div>
  </div>
  -->

  <div class="relative max-w-5xl mx-auto px-4">
    <div class="text-center mb-6">
      <h2
        class={`font-unbounded text-2xl sm:text-3xl font-bold mb-1.5 ${
          isTelefonia ? "text-black" : "text-white drop-shadow-sm"
        }`}
      >
        También te puede interesar
      </h2>

      <p
        class={`font-poppins text-[13px] ${
          isTelefonia ? "text-black/80" : "text-slate-300 drop-shadow-sm"
        }`}
      >
        Conoce todo lo que Be Online tiene para ti.
      </p>
    </div>

    <!-- Cards compactas, alineadas a la derecha de la sección para dejar ver mano+phone en izq -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mx-auto max-w-3xl">
      {
        cards.map((card) => (
          <a
            href={card.href}
            class="group block bg-[#142035] border border-slate-800/80 rounded-xl shadow-md hover:shadow-xl hover:border-slate-700 hover:-translate-y-0.5 transition-all duration-300 px-4 py-3.5"
          >
            <h3 class="font-unbounded text-[13px] font-bold text-white mb-1 group-hover:text-panda-red transition-colors leading-tight">
              {card.title}
            </h3>
            <p class="font-poppins text-[11px] text-slate-300 leading-snug mb-2 line-clamp-2">
              {card.description}
            </p>
            <span class="inline-flex items-center gap-0.5 text-[11px] font-bold text-panda-red">
              {card.cta}
              <svg
                class="w-3 h-3 transition-transform group-hover:translate-x-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
