---
interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  bgImage?: string;
  service?: string;
}

const {
  title = "¿Listo para conectarte con Be Online?",
  subtitle = "Sin contratos, sin letra chica. Tu conexión empieza hoy.",
  ctaLabel = "Comprar plan",
  ctaHref = "/contrata",
  secondaryLabel = "Hablar con soporte",
  secondaryHref = "mailto:info@beonline.mx",
  bgImage = "/img/banners/services/telefonia-06.webp",
  service = "",
} = Astro.props;

const isMifi = service === "mifi";
---

<section
  class:list={[
    "relative py-16 px-4 overflow-hidden",
    isMifi ? "bg-[#FFCD54] text-black" : "bg-panda-dark text-white",
  ]}
>
  {
    !isMifi && (
      <img
        src={bgImage}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="lazy"
      />
    )
  }
  <div
    class:list={[
      "absolute inset-0 pointer-events-none",
      isMifi
        ? "bg-[#FFCD54]/88"
        : "bg-panda-dark/58",
    ]}
  >
  </div>

  <div class="relative max-w-4xl mx-auto text-center">
    <h2
      class:list={[
        "font-unbounded text-3xl sm:text-4xl font-bold mb-3",
        isMifi ? "text-black" : "text-white",
      ]}
    >
      {title}
    </h2>

    <p
      class:list={[
        "font-poppins text-lg mb-8",
        isMifi ? "text-black/80" : "text-gray-300",
      ]}
    >
      {subtitle}
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={ctaHref}
        class:list={[
          "inline-flex items-center justify-center px-8 py-3 rounded-full font-semibold transition-colors",
          isMifi
            ? "bg-black hover:bg-black/85 text-[#FFCD54]"
            : "bg-panda-red hover:bg-panda-red-dark text-white",
        ]}
      >
        {ctaLabel}
      </a>

      <a
        href={secondaryHref}
        target={secondaryHref.startsWith("http") ? "_blank" : undefined}
        rel={secondaryHref.startsWith("http") ? "noopener" : undefined}
        class:list={[
          "inline-flex items-center justify-center px-8 py-3 rounded-full font-semibold transition-colors border",
          isMifi
            ? "bg-white/50 hover:bg-white/70 text-black border-black/15"
            : "bg-white/10 hover:bg-white/20 text-white border-white/10",
        ]}
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
