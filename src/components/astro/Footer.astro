---
import logoBeOnline from "@/assets/images/logo_black.png";
// Enlaces de tiendas de aplicaciones
const playStoreUrl =
  "https://play.google.com/store/apps/details?id=com.beonline.appbeonlinemx&hl=es_MX";
const appStoreUrl = "https://apps.apple.com/mx/app/be-online/id6761391096";
---

<footer class="bg-[#1a1e29] font-sans">
  <!-- CONTENIDO PRINCIPAL DEL FOOTER -->
  <div class="max-w-[1200px] mx-auto px-4 py-12 md:py-16">
    <div
      class="flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-8"
    >
      <!-- COLUMNA IZQUIERDA: Logo e Información -->
      <div class="flex flex-col w-full lg:w-[35%]">
        <!-- Logo (Asegúrate de reemplazar con tu imagen real) -->
        <a
          href="/"
          class="flex items-center gap-3 mb-6 hover:opacity-90 transition-opacity"
        >
          <img src={logoBeOnline.src} alt="Logo BeOnline" class="w-32" />
        </a>

        <!-- Dirección y Contacto -->
        <p class="text-white text-[12.5px] font-medium leading-relaxed mb-3">
          Portal San Ángel, Av. Revolución 1267 piso 19<br />
          Col. Los Alpes, Álvaro Obregón, CP 01040, CDMX
        </p>
        <a
          href="mailto:info@beonline.mx"
          class="text-white text-[12.5px] font-bold hover:text-[#fccd4d] transition-colors"
        >
          info@beonline.mx
        </a>
      </div>

      <!-- COLUMNA DERECHA: Enlaces y Menús -->
      <div
        class="flex flex-wrap md:flex-nowrap gap-8 lg:gap-10 w-full lg:w-[65%] justify-start lg:justify-end"
      >
        <!-- APPS MÓVILES -->
        <div class="flex flex-col gap-3.5 min-w-[120px]">
          <h3
            class="text-[#fccd4d] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Apps Móviles
          </h3>
          <a
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:scale-105 transition-transform inline-block"
          >
            <img
              src="/img/badges/app-store-badge.svg"
              alt="Descargar en App Store"
              class="h-[34px] border border-gray-500 rounded-[6px]"
              onerror="this.style.display='none'"
            />
          </a>
          <a
            href={playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:scale-105 transition-transform inline-block"
          >
            <img
              src="/img/badges/google-play-badge.svg"
              alt="Disponible en Google Play"
              class="h-[34px] border border-gray-500 rounded-[6px]"
              onerror="this.style.display='none'"
            />
          </a>
        </div>

        <!-- COMPRAS -->
        <div class="flex flex-col gap-3.5 min-w-[90px]">
          <h3
            class="text-[#fccd4d] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Compras
          </h3>
          <a
            href="/planes"
            class="text-white text-[13px] font-bold hover:text-[#fccd4d] transition-colors"
            >Planes</a
          >
        </div>

        <!-- HERRAMIENTAS -->
        <div class="flex flex-col gap-3.5 min-w-[120px]">
          <h3
            class="text-[#fccd4d] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Herramientas
          </h3>
          <a
            href="/cobertura"
            class="text-white text-[13px] font-bold hover:text-[#fccd4d] transition-colors"
            >Cobertura</a
          >
          <a
            href="/compatibilidad"
            class="text-white text-[13px] font-bold hover:text-[#fccd4d] transition-colors"
            >Compatibilidad</a
          >
          <a
            href="/recargas"
            class="text-white text-[13px] font-bold hover:text-[#fccd4d] transition-colors"
            >Recargas</a
          >
        </div>

        <!-- BE PROTECTED -->
        <div class="flex flex-col gap-3.5 min-w-[150px]">
          <h3
            class="text-[#fccd4d] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Be Protected
          </h3>
          <a
            href="/beneficios"
            class="text-white text-[13px] font-bold hover:text-[#fccd4d] transition-colors"
            >Programa Beneficios</a
          >
        </div>

        <!-- SOPORTE -->
        <div class="flex flex-col gap-3.5 min-w-[130px]">
          <h3
            class="text-[#fccd4d] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Soporte
          </h3>
          <a
            href="/faq"
            class="text-white text-[13px] font-bold hover:text-[#fccd4d] transition-colors"
            >FAQS</a
          >

          <div class="mt-1">
            <p class="text-white text-[13px] font-bold mb-2">
              Atención a Clientes:
            </p>
            <a
              href="https://wa.me/5211234567890"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-white hover:text-[#fccd4d] transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-[#25D366] fill-current"
                viewBox="0 0 24 24"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              <span class="font-bold text-[14px] tracking-widest">????</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BARRA LEGAL INFERIOR (Fondo Amarillo) -->
  <div class="bg-white py-3.5 px-4">
    <div class="max-w-[1200px] mx-auto text-center">
      <p
        class="text-[#1a1e29] text-[11px] font-semibold flex flex-wrap justify-center items-center gap-x-1.5 gap-y-2 leading-relaxed"
      >
        <a
          href="/aviso-de-privacidad"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Aviso de privacidad</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/terminos-y-condiciones"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Términos y Condiciones</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/contratos"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Contratos</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/condiciones-de-uso"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Condiciones de Uso</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/seguridad-y-justicia"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Seguridad y Justicia</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/neutralidad-de-la-red"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Neutralidad de la Red</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/codigo-de-practicas-comerciales"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Código de Prácticas Comerciales</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/carta-derechos-minimos"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Carta de Derechos Mínimos de Usuarios</a
        >
        <span class="text-[#1a1e29] font-normal">|</span>
        <a
          href="/tarifas-registradas"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Tarifas Registradas</a
        >
      </p>
    </div>
  </div>
</footer>
