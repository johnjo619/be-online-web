---
import logoBeOnline from "@/assets/images/logo_black.png";
// Enlaces de tiendas de aplicaciones
const playStoreUrl =
  "https://play.google.com/store/apps/details?id=com.beonline.appbeonlinemx&hl=es_MX";
const appStoreUrl = "https://apps.apple.com/mx/app/be-online/id6761391096";
---

<footer class="bg-[#142035] font-sans">
  <!-- CONTENIDO PRINCIPAL DEL FOOTER -->
  <div class="max-w-[1200px] mx-auto px-4 py-12 md:py-16">
    <div
      class="flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-8"
    >
      <!-- COLUMNA IZQUIERDA: Logo e Información -->
      <div class="flex flex-col w-full lg:w-[35%]">
        <!-- Logo (Asegúrate de reemplazar con tu imagen real) -->
        <a
          href="/"
          class="flex items-center gap-3 mb-6 hover:opacity-90 transition-opacity"
        >
          <img src={logoBeOnline.src} alt="Logo BeOnline" class="w-32" />
        </a>

        <!-- Dirección y Contacto -->
        <p class="text-white text-[12.5px] font-medium leading-relaxed mb-3">
          Portal San Ángel, Av. Revolución 1267 piso 19<br />
          Col. Los Alpes, Álvaro Obregón, CP 01040, CDMX
        </p>
        <a
          href="mailto:info@beonline.mx"
          class="text-white text-[12.5px] font-bold hover:text-[#FFCD54] transition-colors"
        >
          info@beonline.mx
        </a>
      </div>

      <!-- COLUMNA DERECHA: Enlaces y Menús -->
      <div
        class="flex flex-wrap md:flex-nowrap gap-8 lg:gap-10 w-full lg:w-[65%] justify-start lg:justify-end"
      >
        <!-- APPS MÓVILES -->
        <div class="flex flex-col gap-3.5 min-w-[120px]">
          <h3
            class="text-[#FFCD54] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Apps Móviles
          </h3>
          <a
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:scale-105 transition-transform inline-block"
          >
            <img
              src="/img/badges/app-store-badge.svg"
              alt="Descargar en App Store"
              class="h-[34px] border border-gray-500 rounded-[6px]"
              onerror="this.style.display='none'"
            />
          </a>
          <a
            href={playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:scale-105 transition-transform inline-block"
          >
            <img
              src="/img/badges/google-play-badge.svg"
              alt="Disponible en Google Play"
              class="h-[34px] border border-gray-500 rounded-[6px]"
              onerror="this.style.display='none'"
            />
          </a>
        </div>

        <!-- COMPRAS -->
        <div class="flex flex-col gap-3.5 min-w-[90px]">
          <h3
            class="text-[#FFCD54] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Compras
          </h3>
          <a
            href="/planes"
            class="text-white text-[13px] font-bold hover:text-[#FFCD54] transition-colors"
            >Planes</a
          >
        </div>

        <!-- HERRAMIENTAS -->
        <div class="flex flex-col gap-3.5 min-w-[120px]">
          <h3
            class="text-[#FFCD54] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Herramientas
          </h3>
          <a
            href="/cobertura"
            class="text-white text-[13px] font-bold hover:text-[#FFCD54] transition-colors"
            >Cobertura</a
          >
          <a
            href="/compatibilidad"
            class="text-white text-[13px] font-bold hover:text-[#FFCD54] transition-colors"
            >Compatibilidad</a
          >
          <a
            href="/recarga/"
            class="text-white text-[13px] font-bold hover:text-[#FFCD54] transition-colors"
            >Recargas</a
          >
        </div>

        <!-- BE PROTECTED -->
        <div class="flex flex-col gap-3.5 min-w-[150px]">
          <h3
            class="text-[#FFCD54] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Be Protected
          </h3>
          <a
            href="/beneficios"
            class="text-white text-[13px] font-bold hover:text-[#FFCD54] transition-colors"
            >Programa Beneficios</a
          >
        </div>

        <!-- SOPORTE -->
        <div class="flex flex-col gap-3.5 min-w-[130px]">
          <h3
            class="text-[#FFCD54] text-[11px] font-extrabold uppercase tracking-widest mb-1"
          >
            Soporte
          </h3>
          <a
            href="/faq"
            class="text-white text-[13px] font-bold hover:text-[#FFCD54] transition-colors"
            >FAQS</a
          >

          <div class="mt-1">
            <p class="text-white text-[13px] font-bold mb-2">
              Atención a Clientes:
            </p>
            <a
              href="mailto:info@beonline.mx"
              class="flex items-center gap-2 text-white hover:text-[#FFCD54] transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-[#FFCD54] fill-current"
                viewBox="0 0 24 24"
              >
                <path
                  d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4.24l-8 4.75-8-4.75V6l8 4.75L20 6v2.24z"
                ></path>
              </svg>
              <span class="font-bold text-[14px]">info@beonline.mx</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BARRA LEGAL INFERIOR (Fondo Amarillo) -->
  <div class="bg-white py-3.5 px-4">
    <div class="max-w-[1200px] mx-auto text-center">
      <p
        class="text-[#142035] text-[11px] font-semibold flex flex-wrap justify-center items-center gap-x-1.5 gap-y-2 leading-relaxed"
      >
        <a
          href="/aviso-de-privacidad"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Aviso de privacidad</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/terminos-y-condiciones"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Términos y Condiciones</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/contratos"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Contratos</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/condiciones-de-uso"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Condiciones de Uso</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/seguridad-y-justicia"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Seguridad y Justicia</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/neutralidad-de-la-red"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Neutralidad de la Red</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/codigo-de-practicas-comerciales"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Código de Prácticas Comerciales</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/carta-derechos-minimos"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Carta de Derechos Mínimos de Usuarios</a
        >
        <span class="text-[#142035] font-normal">|</span>
        <a
          href="/tarifas-registradas"
          class="hover:underline hover:opacity-80 transition-opacity"
          >Tarifas Registradas</a
        >
      </p>
    </div>
  </div>
</footer>
