---
/**
 * Sub-nav horizontal de la home — strip blanco justo debajo del Hero.
 * Per spec del PDF de diseño: SIM | Internet en casa | Internet portátil | Cobertura | FAQ
 * Visualmente similar al ServiceSubNav de páginas internas, pero como nav de
 * la home apunta a los anchors locales (#planes, #internet-casa, #mifi, #cobertura, #faq).
 */

interface Tab {
  label: string;
  href: string;
  icon: 'sim' | 'home' | 'wifi' | 'map' | 'help';
}

const tabs: Tab[] = [
  { label: 'SIM',              href: '#planes',          icon: 'sim' },
  { label: 'Internet en casa', href: '#internet-casa',   icon: 'home' },
  { label: 'Internet portátil', href: '#mifi',           icon: 'wifi' },
  { label: 'Cobertura',        href: '#cobertura',       icon: 'map' },
  { label: 'FAQ',              href: '#faq',             icon: 'help' },
];
---

<nav
  aria-label="Navegación de servicios"
  class="bg-[#fff1ec] border-y border-panda-red/10"
>
  <div class="max-w-6xl mx-auto px-4">
    <ul class="flex items-center justify-center gap-1 overflow-x-auto scrollbar-hide">
      {tabs.map((tab) => (
        <li class="flex-shrink-0">
          <a
            href={tab.href}
            class="flex items-center gap-2 px-4 md:px-5 py-2.5 min-h-[34px] text-[11px] font-poppins font-semibold whitespace-nowrap text-panda-dark/70 hover:text-panda-red hover:bg-white/60 transition-colors border-b-2 border-transparent hover:border-panda-red"
          >
            <svg class="w-3 h-3 text-panda-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              {tab.icon === 'sim'  && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4v16a1 1 0 001 1h12a1 1 0 001-1V8.5L14.5 4H6a1 1 0 00-1 1zM7 18h4M7 14h10M7 10h10" />}
              {tab.icon === 'home' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />}
              {tab.icon === 'wifi' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />}
              {tab.icon === 'map'  && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />}
              {tab.icon === 'help' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093M12 17h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />}
            </svg>
            <span>{tab.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { scrollbar-width: none; }
</style>
