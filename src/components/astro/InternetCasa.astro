---
import HBBSelector from "../react/HBBSelector";
---

<!-- Internet en Casa — header con copy a la izq + banner panda gaming
     contenido en card lateral (no full-bleed para no invadir secciones
     vecinas). HBBSelector va con hideHeader para no duplicar el título. -->
<section
  id="internet-casa"
  class="relative py-16 md:py-24 bg-gray-50 overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-4">
    <!-- Header grid: copy izq + banner derecha -->
    <div
      class="grid md:grid-cols-[1fr_auto] gap-8 lg:gap-12 items-center mb-14"
    >
      <div class="max-w-lg">
        <p
          class="font-poppins text-[11px] uppercase tracking-[0.2em] text-panda-red font-semibold mb-3"
        >
          Sin cables · Sin instalación
        </p>
        <h2
          class="font-unbounded text-3xl sm:text-4xl md:text-5xl font-bold text-panda-dark mb-5 leading-tight"
        >
          Internet en Casa
        </h2>
        <p
          class="font-poppins text-base sm:text-lg text-panda-gray leading-relaxed mb-6"
        >
          Internet HBB de alta velocidad. Llega donde la fibra no llega — ideal
          para streaming, videollamadas y gaming sin lag.
        </p>
        <ul class="font-poppins text-sm text-panda-dark space-y-2.5">
          <li class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-panda-green flex-shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path></svg
            >
            Sin contratos ni permanencia
          </li>
          <li class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-panda-green flex-shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path></svg
            >
            Router incluido (opcional)
          </li>
          <li class="flex items-center gap-2">
            <svg
              class="w-5 h-5 text-panda-green flex-shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path></svg
            >
            Conecta hasta 30 dispositivos
          </li>
        </ul>
      </div>

      <!-- Banner del diseño contenido en card 400x280 — no bleed -->
      <div
        class="relative w-full max-w-md md:w-[400px] aspect-[16/11] rounded-3xl overflow-hidden shadow-xl"
      >
        <img
          src="/img/banners/hbb-panda-gaming.webp"
          alt="Internet en casa Be Online para gaming"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Plan selector (sin header propio) -->
    <HBBSelector client:visible hideHeader />
  </div>
</section>
