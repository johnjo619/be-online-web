---

---

<section
  id="mayoristas"
  class="relative py-14 md:py-20 overflow-hidden bg-panda-red"
>
  <!-- Banner full-bleed — muestra $ icons izq + pandas der como el diseño -->
  <div class="absolute inset-0 pointer-events-none">
    <img
      src="/img/banners/hero-home.jpg"
      alt=""
      aria-hidden="true"
      class="w-full h-full object-cover object-center opacity-90"
      loading="lazy"
    />
    <!-- Overlay rojo tenue para que las cards blancas se lean bien -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-panda-red/35 via-panda-red/22 to-panda-red/45"
    >
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4">
    <!-- Header centrado per PDF -->
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2
        class="font-unbounded text-3xl sm:text-4xl font-bold text-white mb-3 drop-shadow-md"
      >
        ¿Quieres vender Be Online?
      </h2>
      <p class="font-poppins text-sm sm:text-base text-white/90">
        Únete a nuestra red de distribuidores y genera ingresos con la marca de
        telefonía que más crece en México
      </p>
    </div>

    <!-- Benefits -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-3xl mx-auto mb-7">
      <!-- Comisiones -->
      <div
        class="group bg-white rounded-lg p-5 text-center hover:shadow-xl transition-shadow border border-white/40"
      >
        <div
          class="w-8 h-8 mx-auto mb-3 rounded-lg bg-panda-green/15 flex items-center justify-center"
        >
          <svg
            class="w-4 h-4 text-panda-green"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-sm font-bold text-panda-dark mb-2">
          Comisiones atractivas
        </h3>
        <p class="font-poppins text-panda-gray text-[11px] leading-snug">
          Gana comisiones competitivas por cada línea activada y por cada
          recarga de tus clientes.
        </p>
      </div>

      <!-- Soporte -->
      <div
        class="group bg-white rounded-lg p-5 text-center hover:shadow-xl transition-shadow border border-white/40"
      >
        <div
          class="w-8 h-8 mx-auto mb-3 rounded-lg bg-panda-red/10 flex items-center justify-center"
        >
          <svg
            class="w-4 h-4 text-panda-red"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-sm font-bold text-panda-dark mb-2">
          Soporte dedicado
        </h3>
        <p class="font-poppins text-panda-gray text-[11px] leading-snug">
          Equipo de soporte exclusivo para distribuidores. Te acompañamos en
          cada paso del camino.
        </p>
      </div>

      <!-- Material POS -->
      <div
        class="group bg-white rounded-lg p-5 text-center hover:shadow-xl transition-shadow border border-white/40"
      >
        <div
          class="w-8 h-8 mx-auto mb-3 rounded-lg bg-amber-400/15 flex items-center justify-center"
        >
          <svg
            class="w-4 h-4 text-amber-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
            ></path>
          </svg>
        </div>
        <h3 class="font-unbounded text-sm font-bold text-panda-dark mb-2">
          Material de punto de venta
        </h3>
        <p class="font-poppins text-panda-gray text-[11px] leading-snug">
          Te proporcionamos material promocional, exhibidores y todo lo
          necesario para impulsar tus ventas.
        </p>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a
        href="mailto:info@beonline.mx"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-panda-green text-white font-bold text-sm hover:bg-panda-green/90 transition-colors shadow-lg shadow-panda-green/20 font-poppins"
      >
        Contactar ventas
        <svg class="ml-2 w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
      </a>
      <p class="font-poppins text-white/85 text-xs mt-3">
        O escríbenos a <a
          href="mailto:info@beonline.mx"
          class="text-white font-semibold hover:underline"
          >info@beonline.mx</a
        >
      </p>
    </div>
  </div>
</section>
