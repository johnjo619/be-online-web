---

---

<section id="mifi" class="bg-panda-surface py-20">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Header -->
    <div class="text-center mb-14">
      <h2
        class="font-unbounded text-3xl sm:text-4xl font-bold text-panda-dark mb-4"
      >
        Internet Portátil MiFi
      </h2>
      <p class="font-poppins text-lg text-panda-gray max-w-2xl mx-auto">
        Lleva tu conexión a donde vayas
      </p>
    </div>

    <!-- Featured card con banner del diseño (panda + grupo en montaña) -->
    <div
      class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg overflow-hidden"
    >
      <div class="grid md:grid-cols-2 gap-0">
        <!-- Image: banner MiFi. Aspect 16:10 mobile matchea la proporción
             natural del banner. object-position 35% center ancla el panda
             (que vive en ~35% del eje horizontal de la imagen) hacia el
             centro visible del crop. -->
        <div
          class="relative bg-panda-red aspect-[16/10] md:aspect-auto md:min-h-[400px]"
        >
          <img
            src="/img/mifi.webp"
            alt="Conectividad MiFi Be Online en cualquier lugar — grupo de excursionistas con panda"
            class="absolute inset-0 w-full h-full object-cover"
            style="object-position: 35% center;"
            loading="lazy"
          />
        </div>

        <!-- Content -->
        <div class="p-10 flex flex-col justify-center">
          <h3 class="font-unbounded text-2xl font-bold text-panda-dark mb-4">
            Tu WiFi personal
          </h3>
          <p class="font-poppins text-panda-gray text-sm mb-6">
            Un dispositivo compacto que te da internet de alta velocidad en
            cualquier lugar. Solo enciéndelo y conéctate.
          </p>

          <ul class="font-poppins text-sm text-panda-dark space-y-4 mb-8">
            <li class="flex items-center gap-3">
              <div
                class="w-8 h-8 rounded-full bg-panda-green/10 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-4 h-4 text-panda-green"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.394 9.393c5.857-5.858 15.355-5.858 21.213 0"
                  ></path></svg
                >
              </div>
              Conecta hasta 10 dispositivos
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-8 h-8 rounded-full bg-panda-green/10 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-4 h-4 text-panda-green"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                >
              </div>
              Batería de larga duración
            </li>
            <li class="flex items-center gap-3">
              <div
                class="w-8 h-8 rounded-full bg-panda-green/10 flex items-center justify-center flex-shrink-0"
              >
                <svg
                  class="w-4 h-4 text-panda-green"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"></path></svg
                >
              </div>
              Sin instalación
            </li>
          </ul>

          <div class="mb-6">
            <span class="font-poppins text-sm text-panda-gray">Desde</span>
            <div>
              <span class="font-unbounded text-4xl font-bold text-panda-red"
                >$299</span
              >
              <span class="font-poppins text-panda-gray text-sm">/mes</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="/tienda/?service=mifi"
              class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-panda-red text-white font-bold hover:bg-panda-red-dark transition-colors shadow-lg shadow-panda-red/30 font-poppins"
            >
              Contratar MiFi nuevo
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
            <a
              href="/activar/?flow=recargar"
              class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-white border-2 border-panda-dark text-panda-dark font-bold hover:bg-panda-surface transition-colors font-poppins"
            >
              Recargar mi MiFi
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
