---
// Qué incluye tu plan: grid 4 features con iconos custom + valor destacado.
import socialNetworks from '../../assets/images/socialNetwork.png';
---

<section class="relative py-14 md:py-20 overflow-hidden bg-white">
  <!-- PSD verificado: fondo BLANCO, sin imagen detrás. 4 cards centradas. -->
  <div class="relative max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="font-unbounded text-3xl sm:text-4xl font-bold text-panda-dark mb-3">
        Qué incluye tu plan
      </h2>
      <p class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto">
        Todo lo que necesitas, sin sobrecargo por roaming, sin letra chica y sin sorpresas en la factura.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">

      <!-- Datos 4G LTE -->
      <div class="group relative bg-white rounded-2xl p-6 border border-gray-100 hover:border-panda-red/30 hover:shadow-xl hover:shadow-panda-red/8 transition-all duration-300">
        <div class="absolute top-0 right-0 w-20 h-20 bg-panda-red/5 rounded-full blur-2xl group-hover:bg-panda-red/15 transition-colors"></div>
        <div class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-panda-red to-panda-red-dark flex items-center justify-center mb-4 shadow-lg shadow-panda-red/25">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/>
          </svg>
        </div>
        <p class="font-poppins text-[10px] text-panda-gray uppercase tracking-wider font-semibold mb-1">Datos</p>
        <p class="font-unbounded text-xl font-bold text-panda-dark mb-2">4G LTE</p>
        <p class="font-poppins text-xs text-panda-gray leading-relaxed">
          Velocidad alta sin sobrecargo por roaming. Cobertura en los 32 estados.
        </p>
      </div>

      <!-- Llamadas -->
      <div class="group relative bg-white rounded-2xl p-6 border border-gray-100 hover:border-panda-red/30 hover:shadow-xl hover:shadow-panda-red/8 transition-all duration-300">
        <div class="absolute top-0 right-0 w-20 h-20 bg-panda-red/5 rounded-full blur-2xl group-hover:bg-panda-red/15 transition-colors"></div>
        <div class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-panda-red to-panda-red-dark flex items-center justify-center mb-4 shadow-lg shadow-panda-red/25">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <p class="font-poppins text-[10px] text-panda-gray uppercase tracking-wider font-semibold mb-1">Llamadas</p>
        <p class="font-unbounded text-xl font-bold text-panda-dark mb-2">Ilimitadas</p>
        <p class="font-poppins text-xs text-panda-gray leading-relaxed">
          A todo México + EE.UU. y Canadá sin costo adicional en planes Mensual y Anual.
        </p>
      </div>

      <!-- SMS -->
      <div class="group relative bg-white rounded-2xl p-6 border border-gray-100 hover:border-panda-red/30 hover:shadow-xl hover:shadow-panda-red/8 transition-all duration-300">
        <div class="absolute top-0 right-0 w-20 h-20 bg-panda-red/5 rounded-full blur-2xl group-hover:bg-panda-red/15 transition-colors"></div>
        <div class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-panda-red to-panda-red-dark flex items-center justify-center mb-4 shadow-lg shadow-panda-red/25">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </div>
        <p class="font-poppins text-[10px] text-panda-gray uppercase tracking-wider font-semibold mb-1">SMS</p>
        <p class="font-unbounded text-xl font-bold text-panda-dark mb-2">Ilimitados</p>
        <p class="font-poppins text-xs text-panda-gray leading-relaxed">
          A cualquier operador en México. Sin contador, sin restricciones por hora del día.
        </p>
      </div>

      <!-- Redes sociales -->
      <div class="group relative bg-white rounded-2xl p-6 border border-gray-100 hover:border-panda-red/30 hover:shadow-xl hover:shadow-panda-red/8 transition-all duration-300 overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-panda-red/5 rounded-full blur-2xl group-hover:bg-panda-red/15 transition-colors"></div>
        <div class="relative w-12 h-12 rounded-xl bg-gradient-to-br from-panda-red to-panda-red-dark flex items-center justify-center mb-4 shadow-lg shadow-panda-red/25">
          <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.11.819-.26.819-.578v-2.021c-3.338.726-4.042-1.61-4.042-1.61-.546-1.386-1.333-1.755-1.333-1.755-1.089-.745.083-.729.083-.729 1.205.085 1.838 1.236 1.838 1.236 1.07 1.834 2.808 1.304 3.493.997.107-.776.42-1.305.762-1.604-2.665-.305-5.466-1.334-5.466-5.93 0-1.31.468-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.54 11.54 0 016.012 0c2.291-1.552 3.297-1.23 3.297-1.23.654 1.652.243 2.873.119 3.176.769.84 1.235 1.911 1.235 3.221 0 4.608-2.804 5.622-5.475 5.92.43.372.823 1.102.823 2.222v3.293c0 .322.218.694.825.576C20.565 21.796 24 17.299 24 12c0-6.627-5.373-12-12-12z" opacity="0.0"/>
          </svg>
          <!-- Cluster overlay de íconos sociales -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="grid grid-cols-2 gap-0.5">
              <div class="w-3 h-3 rounded bg-white/95 flex items-center justify-center">
                <svg class="w-2 h-2 text-panda-red" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div class="w-3 h-3 rounded bg-white/95 flex items-center justify-center">
                <svg class="w-2 h-2 text-panda-red" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </div>
              <div class="w-3 h-3 rounded bg-white/95 flex items-center justify-center">
                <svg class="w-2 h-2 text-panda-red" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
              </div>
              <div class="w-3 h-3 rounded bg-white/95 flex items-center justify-center">
                <svg class="w-2 h-2 text-panda-red" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </div>
            </div>
          </div>
        </div>
        <p class="font-poppins text-[10px] text-panda-gray uppercase tracking-wider font-semibold mb-1">Redes sociales</p>
        <p class="font-unbounded text-xl font-bold text-panda-dark mb-2">Sin consumir</p>
        <p class="font-poppins text-xs text-panda-gray leading-relaxed">
          WhatsApp, Facebook, Instagram, X y TikTok no consumen tus datos del plan.
        </p>
      </div>

    </div>

    <!-- Footnote -->
    <p class="text-center font-poppins text-[11px] text-panda-gray mt-7 max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-panda-red" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Soporte humano por <strong class="text-panda-dark">*777</strong> y WhatsApp — sin menús eternos
      </span>
    </p>
  </div>
</section>
