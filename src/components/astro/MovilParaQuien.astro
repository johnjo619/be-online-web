---
// ¿Para quién es Be Online?: testimonios reales con 5 estrellas + comilla grande.
// Sin círculos CRM. Estilo trust-card de SaaS. BG sunset PSD telefonia-04.

const testimonios = [
  {
    nombre: "Ana M.",
    rol: "Freelancer",
    ciudad: "Querétaro",
    quote:
      "Cambié de plan caro a Anual y ahorré $3,600 al año. Misma señal, mismas redes ilimitadas.",
  },
  {
    nombre: "Juan Carlos",
    rol: "Segunda línea",
    ciudad: "CDMX",
    quote:
      "Una línea para mi trabajo, sin contrato, sin compromiso. La pago al inicio del mes y listo.",
  },
  {
    nombre: "Lucía R.",
    rol: "Familiar de cliente",
    ciudad: "Oaxaca",
    quote:
      "Le activé un Mensual a mi mamá. Cobertura en su pueblo donde Telcel no llegaba.",
  },
  {
    nombre: "Daniel S.",
    rol: "Viajero",
    ciudad: "Guadalajara",
    quote:
      "Xpress 7 días cuando viajo, me activan eSIM en 5 minutos. Sin tener que ir a una sucursal.",
  },
];
---

<section
  class="relative overflow-hidden bg-[#AC6441] min-h-[480px] md:min-h-0 md:aspect-[1927/514]"
>
  <!-- BG sunset telefonia-04 (1927x514, aspect 3.75:1): aspect-locked como S3
       para que la imagen llene perfecto SIN zoom y SIN white space. Contenido
       compacto encima centrado. Mobile: aspect natural + min-height. -->
  <img
    src="/img/banners/services/telefonia-04.webp"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-cover object-center"
    loading="lazy"
  />

  <div
    class="relative md:absolute md:inset-0 flex flex-col items-center justify-center px-4 py-12 md:py-0"
  >
    <div class="text-center mb-5 md:mb-6">
      <h2
        class="font-unbounded text-xl sm:text-2xl md:text-[28px] lg:text-[32px] font-bold text-white mb-1.5 drop-shadow-lg leading-tight"
      >
        ¿Para quién es Be Online?
      </h2>
      <p
        class="font-poppins text-[11px] sm:text-xs md:text-[13px] text-white max-w-xl mx-auto drop-shadow leading-snug"
      >
        Si te molesta pagar por servicios que no usas, los contratos eternos o
        las renovaciones automáticas con sorpresa — Be Online es para ti.
      </p>
    </div>

    <div
      class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 md:gap-3 max-w-5xl w-full mx-auto"
    >
      {
        testimonios.map((t) => (
          <article class="relative bg-white rounded-xl px-3 py-3 md:px-4 md:py-3.5 shadow-xl flex flex-col">
            <div
              class="flex items-center gap-0.5 mb-1.5"
              aria-label="5 de 5 estrellas"
            >
              {[1, 2, 3, 4, 5].map(() => (
                <svg
                  class="w-3 h-3 text-amber-400"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="font-poppins text-[11px] md:text-[11.5px] text-panda-dark leading-snug mb-2 flex-grow">
              "{t.quote}"
            </p>
            <div class="pt-1.5 border-t border-gray-100">
              <p class="font-unbounded text-[11px] md:text-[12px] font-bold text-panda-dark leading-tight">
                {t.nombre}
              </p>
              <p class="font-poppins text-[9px] md:text-[10px] text-panda-gray mt-0.5">
                {t.rol} · {t.ciudad}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
