---
import astronauta2Img from "@/assets/images/astronauta2.png";
---

<section
  id="portabilidad-cobertura"
  class="relative py-16 md:py-24 bg-[#fccd4d] overflow-hidden font-sans"
>
  <div class="relative max-w-[1000px] mx-auto px-4">
    <div
      class="relative bg-white rounded-[2.5rem] shadow-xl p-8 md:p-12 mt-16 mb-24 flex flex-col md:flex-row items-center text-center"
    >
      <img
        src={astronauta2Img.src}
        alt="Astronauta con teléfono"
        class="md:absolute static -mt-28 md:mt-0 md:-left-20 lg:-left-48 md:top-1/2 md:-translate-y-1/2 w-56 md:w-[450px] lg:w-[320px] object-contain drop-shadow-2xl z-10 mx-auto md:mx-0"
        onerror="this.style.display='none'"
      />

      <div class="flex-1 z-20 flex flex-col items-center">
        <h2
          class="text-2xl md:text-4xl leading-[1.15] font-bold text-[#1a1e29] mb-2 tracking-tight"
        >
          Conserva tu número<br /> y suma beneficios.
        </h2>
        <p class="text-[#1a1e29] text-2xl mb-8">
          Mismo número, nueva experiencia.<br />Gratis y rápido.
        </p>

        <div
          class="flex flex-wrap md:flex-nowrap justify-center items-center gap-2 md:gap-4 mb-8"
        >
          <div class="flex flex-col items-center">
            <span class="font-black text-[#1a1e29] text-3xl">1</span>
            <span
              class="text-lg text-center text-[#1a1e29] leading-tight font-semibold mt-1"
              >Solicita tu<br />portabilidad</span
            >
          </div>

          <div class="hidden md:flex text-[#fccd4d] mb-4">
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"
              ><path d="M5 3l14 9-14 9z"></path></svg
            >
          </div>

          <div class="flex flex-col items-center">
            <span class="font-black text-[#1a1e29] text-3xl">2</span>
            <span
              class="text-lg text-center text-[#1a1e29] leading-tight font-semibold mt-1"
              >Nosotros hacemos<br />el trámite</span
            >
          </div>

          <div class="hidden md:flex text-[#fccd4d] mb-4">
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"
              ><path d="M5 3l14 9-14 9z"></path></svg
            >
          </div>

          <div class="flex flex-col items-center">
            <span class="font-black text-[#1a1e29] text-3xl">3</span>
            <span
              class="text-lg text-center text-[#1a1e29] leading-tight font-semibold mt-1"
              >Validamos y<br />liberamos tu línea</span
            >
          </div>

          <div class="hidden md:flex text-[#fccd4d] mb-4">
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"
              ><path d="M5 3l14 9-14 9z"></path></svg
            >
          </div>

          <div class="flex flex-col items-center">
            <span class="font-black text-[#1a1e29] text-3xl">4</span>
            <span
              class="text-lg text-center text-[#1a1e29] leading-tight font-semibold mt-1"
              >Comienza a navegar<br />y vete al cine!</span
            >
          </div>
        </div>

        <a
          href="/activar/?flow=portar"
          class="inline-block bg-[#1a1e29] text-white text-lg font-bold px-4 py-1 rounded-full hover:bg-black hover:scale-105 transition-all shadow-md"
        >
          Tu portabilidad en un clic
        </a>
      </div>
    </div>

    <div
      class="relative text-center z-20 mt-16 pt-8 pb-12 flex flex-col items-center justify-center"
    >
      <div
        class="absolute inset-0 flex items-center justify-center z-0 pointer-events-none mt-16"
      >
        <img
          src="/mapa-mexico-puntos.svg"
          alt="Mapa Cobertura"
          class="w-full max-w-[600px] object-contain opacity-60"
          onerror="this.style.display='none'"
        />
      </div>

      <div class="relative z-10 w-full">
        <h2
          class="text-xl md:text-2xl lg:text-3xl font-black text-[#1a1e29] mb-4 tracking-tight"
        >
          Be Everywhere: Conexión total en todo México.
        </h2>
        <p
          class="text-[#1a1e29] text-lg md:text-2xl font-semibold mb-10 leading-snug"
        >
          Señal nacional, velocidad total con 4G LTE.<br />Siempre conectado.
        </p>

        <a
          href="/cobertura"
          class="inline-block bg-[#1a1e29] text-white text-md font-bold px-4 py-1 rounded-full hover:bg-black hover:scale-105 transition-all shadow-md"
        >
          Consulta tu cobertura aquí
        </a>
      </div>
    </div>
  </div>
</section>
