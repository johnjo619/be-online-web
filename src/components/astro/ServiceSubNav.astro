---
export type ServiceTab = "telefonia" | "internet-hogar" | "mifi" | "cobertura";

interface Props {
  active: ServiceTab;
}

const { active } = Astro.props;

const tabs: { key: ServiceTab; label: string; href: string; icon: string }[] = [
  {
    key: "telefonia",
    label: "Telefonía móvil",
    href: "/telefonia-movil/",
    icon: "phone",
  },
  // {
  //   key: "internet-hogar",
  //   label: "Internet en casa",
  //   href: "/internet-en-casa/",
  //   icon: "home",
  // },
  {
    key: "mifi",
    label: "Internet portátil",
    href: "/internet-portatil/",
    icon: "wifi",
  },
  { key: "cobertura", label: "Cobertura", href: "/cobertura/", icon: "map" },
];
---

<nav
  aria-label="Servicios Be Online"
  class="sticky top-16 z-40 bg-white/95 backdrop-blur-sm border-b border-gray-100"
  style="top: calc(var(--banner-h, 0px) + 72px);"
>
  <div class="max-w-6xl mx-auto px-4">
    <ul class="flex items-center gap-1 overflow-x-auto scrollbar-hide">
      {
        tabs.map((tab) => {
          const isActive = tab.key === active;
          return (
            <li class="flex-shrink-0">
              <a
                href={tab.href}
                role="tab"
                aria-selected={isActive ? "true" : "false"}
                class:list={[
                  "flex items-center gap-2 px-4 py-3 min-h-[44px] text-sm font-poppins font-medium whitespace-nowrap transition-colors border-b-2",
                  isActive
                    ? "text-panda-red border-panda-red"
                    : "text-panda-gray border-transparent hover:text-panda-dark hover:border-gray-200",
                ]}
              >
                <svg
                  class="w-4 h-4 sm:w-5 sm:h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  {tab.icon === "phone" && (
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    />
                  )}
                  {tab.icon === "home" && (
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                    />
                  )}
                  {tab.icon === "wifi" && (
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"
                    />
                  )}
                  {tab.icon === "map" && (
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                    />
                  )}
                </svg>
                <span>{tab.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    scrollbar-width: none;
  }
</style>
