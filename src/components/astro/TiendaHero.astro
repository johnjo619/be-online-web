---
import Breadcrumb from "./Breadcrumb.astro";
---

<section class="bg-panda-surface py-16">
  <div class="max-w-6xl mx-auto px-4">
    <Breadcrumb
      items={[{ label: "Inicio", href: "/" }, { label: "Contratar" }]}
    />

    <h1
      class="font-unbounded text-3xl sm:text-4xl md:text-5xl font-bold text-panda-dark mb-4"
    >
      Contrata tu plan Be Online
    </h1>
    <p class="font-poppins text-lg text-panda-gray max-w-xl mb-10">
      Telefonía móvil, internet en casa o internet portátil. Sin contratos, sin
      letra chica. Para HBB y MiFi puedes elegir si incluyes el equipo o solo
      activas el plan.
    </p>

    <!-- 3 Mini Steps -->
    <div class="grid grid-cols-3 gap-4 max-w-md">
      <div class="flex flex-col items-center text-center">
        <div
          class="w-12 h-12 rounded-xl bg-panda-red/10 flex items-center justify-center mb-2"
        >
          <svg
            class="w-6 h-6 text-panda-red"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            ></path>
          </svg>
        </div>
        <p class="font-poppins text-xs font-semibold text-panda-dark">
          Elige servicio
        </p>
      </div>
      <div class="flex flex-col items-center text-center">
        <div
          class="w-12 h-12 rounded-xl bg-panda-red/10 flex items-center justify-center mb-2"
        >
          <svg
            class="w-6 h-6 text-panda-red"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
            ></path>
          </svg>
        </div>
        <p class="font-poppins text-xs font-semibold text-panda-dark">
          Paga seguro
        </p>
      </div>
      <div class="flex flex-col items-center text-center">
        <div
          class="w-12 h-12 rounded-xl bg-panda-red/10 flex items-center justify-center mb-2"
        >
          <svg
            class="w-6 h-6 text-panda-red"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
            ></path>
          </svg>
        </div>
        <p class="font-poppins text-xs font-semibold text-panda-dark">
          Activa y navega
        </p>
      </div>
    </div>
  </div>
</section>
