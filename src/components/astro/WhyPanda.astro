---
interface Props {
  variant?: "home" | "service";
}

const { variant = "service" } = Astro.props;

const reasons = [
  {
    title: "Sin contratos",
    description:
      "Recargas cuando quieras y cancelas cuando quieras. Cero permanencia, cero letra chica.",
    icon: "check",
  },
  {
    title: "Cobertura nacional",
    description:
      "4G LTE en los 32 estados sobre la Red Compartida Altán, sin sobrecargos por roaming nacional.",
    icon: "globe",
  },
  {
    title: "Atención humana",
    description:
      "Marca *777 desde tu línea o escríbenos por WhatsApp. Soporte real, sin menús eternos.",
    icon: "heart",
  },
];

const headingText =
  variant === "home" ? "Por qué elegir Be Online" : "¿Por qué Be Online?";
---

<section class={`${variant === "service" ? "py-14" : "py-20"} bg-[#1a1e29]`}>
  <div class="max-w-6xl mx-auto px-4">
    {
      variant === "home" && (
        <div class="text-center mb-12">
          <h2 class="font-unbounded text-3xl sm:text-4xl font-bold text-white mb-4">
            {headingText}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        reasons.map((r) => (
          <div class="bg-[#1f2431] border border-slate-800 rounded-xl p-6 hover:shadow-lg hover:border-slate-700 transition-all duration-300">
            <div class="w-10 h-10 rounded-full bg-panda-red/10 flex items-center justify-center mb-4">
              <svg
                class="w-5 h-5 text-panda-red"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                {r.icon === "check" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                )}
                {r.icon === "globe" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                )}
                {r.icon === "heart" && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  />
                )}
              </svg>
            </div>
            <h3 class="font-unbounded font-bold text-white mb-2">
              {r.title}
            </h3>
            <p class="font-poppins text-sm text-slate-300 leading-relaxed">
              {r.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
