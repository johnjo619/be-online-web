---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import DynamicBanner from '../components/react/DynamicBanner';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro?: string;
  pending?: boolean;
}

const { title, description, heading, intro, pending = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <DynamicBanner client:idle transition:persist transition:name="panda-banner" />
  <Header transition:persist transition:name="panda-header" />
  <main class="pt-28 pb-16 px-4" transition:name="panda-main">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-unbounded text-3xl sm:text-4xl font-bold text-panda-dark mb-6">{heading}</h1>

      {intro && (
        <p class="text-panda-gray font-poppins text-lg mb-8">{intro}</p>
      )}

      {pending && (
        <div class="bg-[#FFCD54]/15 border border-[#FFCD54]/50 rounded-lg p-4 mb-8">
          <p class="text-sm text-[#142035] font-poppins">
            <strong>Documento en preparación.</strong> Esta sección será publicada próximamente con el contenido oficial.
            Mientras tanto, para consultas escríbenos a <a href="mailto:info@beonline.mx" class="underline">info@beonline.mx</a>.
          </p>
        </div>
      )}

      <article class="prose prose-lg max-w-none text-panda-gray font-poppins">
        <slot />
      </article>
    </div>
  </main>
  <Footer transition:persist transition:name="panda-footer" />
</BaseLayout>
