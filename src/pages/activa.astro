---
// /activa y /recarga son el mismo flujo (activar/recargar lo decide la
// validación del número dentro del wizard). /recarga es la página canónica;
// aquí solo redirigimos preservando ?msisdn= / ?numero=.
// Static output: redirect via meta refresh + JS instant.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Activa Be Online — Redirigiendo…</title>
    <link rel="canonical" href="https://beonline.celink.mx/recarga/" />
    <meta http-equiv="refresh" content="0; url=/recarga/" />
    <script>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var dest = "/recarga/" + (params.toString() ? "?" + params.toString() : "");
        window.location.replace(dest);
      })();
    </script>
    <style is:inline>
      .pm-redirect-root {
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
        background: #fafafa;
        color: #0f172a;
      }
      .pm-redirect-root .loader {
        text-align: center;
      }
      .pm-redirect-root .loader p {
        margin: 0;
        font-size: 14px;
        color: #7a7a7a;
      }
      .pm-redirect-root .loader a {
        color: #1a1e29;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body class="pm-redirect-root">
    <div class="loader">
      <p>Redirigiendo a activación y recargas…</p>
      <p style="margin-top: 8px;">
        <a href="/recarga/"
          >Haz clic aquí si no se redirige automáticamente</a
        >
      </p>
    </div>
  </body>
</html>
