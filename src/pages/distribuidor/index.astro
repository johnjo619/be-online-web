---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/astro/Header.astro";
import DynamicBanner from "../../components/react/DynamicBanner";
import Hero from "../../components/astro/distribuidor/Hero.astro";
import HowItWorks from "../../components/astro/distribuidor/HowItWorks.astro";
import CommissionCalculator from "../../components/react/CommissionCalculator";
import StarterPack from "../../components/astro/distribuidor/StarterPack.astro";
import Faq from "../../components/astro/distribuidor/Faq.astro";
import DistributorLeadForm from "../../components/react/DistributorLeadForm";
import Footer from "../../components/astro/Footer.astro";
import { organizationSchema } from "../../lib/schema";

const jsonLd = [
  organizationSchema(),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Programa de Distribuidores Be Online",
    description:
      "Conviértete en distribuidor Be Online. Comisiones del 10% mensual recurrente, 20% por activación, 20% por portabilidad y 5% en tiempo aire. Pack inicial $500 MXN.",
    provider: { "@type": "Organization", name: "Be Online" },
    areaServed: { "@type": "Country", name: "México" },
    serviceType: "Distribución de telefonía móvil",
    offers: {
      "@type": "Offer",
      price: "500",
      priceCurrency: "MXN",
      description:
        "Pack inicial de distribuidor: 10 SIMs + $750 saldo + materiales + Oficina Virtual",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: "https://beonline.celink.mx/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Distribuidores",
        item: "https://beonline.celink.mx/distribuidor/",
      },
    ],
  },
];

const WA_HREF =
  "mailto:info@beonline.mx" +
  encodeURIComponent("Hola, me interesa ser distribuidor Be Online");
---

<BaseLayout
  title="Conviértete en distribuidor Be Online — Comisiones 10-20% + pack desde $500 MXN"
  description="Únete al programa de distribuidores Be Online. Gana 10% mensual recurrente, 20% por activación, 20% por portabilidad. Pack inicial $500 MXN incluye 10 SIMs gratis y $750 de saldo. Sin requisitos adicionales."
  jsonLd={jsonLd}
>
  <DynamicBanner client:idle />
  <Header />

  <main>
    <Hero />
    <HowItWorks />
    <CommissionCalculator client:visible />
    <StarterPack />

    <!-- Form de solicitud (anchor #solicitud) -->
    <section
      id="solicitud"
      class="py-16 sm:py-20 bg-panda-dark relative overflow-hidden"
    >
      <div class="absolute inset-0 opacity-10">
        <div
          class="absolute top-10 right-20 w-72 h-72 rounded-full border-2 border-white"
        >
        </div>
        <div
          class="absolute bottom-10 left-10 w-56 h-56 rounded-full border border-white"
        >
        </div>
      </div>
      <div
        class="relative max-w-5xl mx-auto px-4 grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-12 items-start"
      >
        <div class="text-white">
          <p
            class="font-poppins text-[11px] uppercase tracking-[0.2em] text-panda-green font-semibold mb-3"
          >
            Solicita tu pack
          </p>
          <h2
            class="font-unbounded text-3xl sm:text-4xl md:text-5xl font-bold mb-5 leading-tight"
          >
            ¿Listo para empezar a generar ingresos?
          </h2>
          <p
            class="font-poppins text-base sm:text-lg text-white/85 max-w-md mb-6"
          >
            Déjanos tus datos y un asesor te contacta en <strong
              class="text-white">menos de 24 horas</strong
            > para procesar tu pack inicial y darte de alta como distribuidor.
          </p>

          <ul class="space-y-3 mb-8 max-w-md">
            <li class="flex items-start gap-3 text-white/90 font-poppins">
              <span
                class="w-6 h-6 rounded-full bg-panda-green/20 flex items-center justify-center flex-shrink-0 mt-0.5"
              >
                <svg
                  class="w-3.5 h-3.5 text-panda-green"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"></path></svg
                >
              </span>
              <span class="text-sm">Sin comisión por contactarnos</span>
            </li>
            <li class="flex items-start gap-3 text-white/90 font-poppins">
              <span
                class="w-6 h-6 rounded-full bg-panda-green/20 flex items-center justify-center flex-shrink-0 mt-0.5"
              >
                <svg
                  class="w-3.5 h-3.5 text-panda-green"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"></path></svg
                >
              </span>
              <span class="text-sm">Respuesta garantizada en menos de 24h</span>
            </li>
            <li class="flex items-start gap-3 text-white/90 font-poppins">
              <span
                class="w-6 h-6 rounded-full bg-panda-green/20 flex items-center justify-center flex-shrink-0 mt-0.5"
              >
                <svg
                  class="w-3.5 h-3.5 text-panda-green"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"></path></svg
                >
              </span>
              <span class="text-sm">Onboarding 1:1 con tu asesor asignado</span>
            </li>
          </ul>

          <div class="hidden sm:block">
            <p class="font-poppins text-xs text-white/60 mb-2">
              ¿Prefieres hablar directo?
            </p>
            <a
              href={WA_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-white hover:text-panda-green transition-colors font-poppins font-semibold text-sm"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                ></path>
              </svg>
              WhatsApp · *34468
            </a>
          </div>
        </div>

        <div class="w-full lg:w-[440px]">
          <DistributorLeadForm client:visible />
        </div>
      </div>
    </section>

    <Faq />
  </main>

  <Footer />

  <!-- WhatsApp button flotante mobile -->
  <a
    href={WA_HREF}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    class="md:hidden fixed bottom-5 right-5 z-40 w-14 h-14 rounded-full bg-panda-green text-white flex items-center justify-center shadow-2xl shadow-panda-green/40 hover:scale-105 transition-transform"
  >
    <svg
      class="w-7 h-7"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
      ></path>
    </svg>
  </a>
</BaseLayout>
