---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import HeroBanner from "../components/react/HeroBanner";
import HowItWorks from "../components/astro/HowItWorks.astro";
import Portabilidad from "../components/astro/Portabilidad.astro";
import FAQ from "../components/astro/FAQ.astro";
import DownloadApp from "../components/astro/DownloadApp.astro";
import CtaFinal from "../components/astro/CtaFinal.astro";
import Footer from "../components/astro/Footer.astro";
import PlanSelector from "../components/react/PlanSelector";
import DynamicBanner from "../components/react/DynamicBanner";
import BeProtected from "@/components/astro/BeProtected.astro";
import {
  organizationSchema,
  webSiteSchema,
  productAggregateSchema,
} from "../lib/schema";
import BannerSeparator from "@/components/astro/BannerSeparator.astro";
import { resumenCatalogo } from "../lib/catalogo-build";

const catalogo = await resumenCatalogo("Movilidad");

const schemas = [
  organizationSchema(),
  webSiteSchema(),
  productAggregateSchema(catalogo),
];
---

<BaseLayout
  title="Be Online — Planes de Telefonía Móvil e Internet Portátil | Sin Contratos"
  description="Planes de telefonía móvil e internet portátil MiFi con cobertura nacional. Sin contratos, sin letra chica, a precios justos. ¡Conéctate con Be Online!"
  jsonLd={schemas}
>
  <DynamicBanner
    client:idle
    transition:persist
    transition:name="panda-banner"
  />
  <Header transition:persist transition:name="panda-header" />
  <main transition:name="panda-main">
    <HeroBanner
      client:load
      fallbackImage="/img/banners/hero-home.jpg"
      fallbackSideImage="/img/banners/astronaut_pop.webp"
    />
    <BannerSeparator />
    <PlanSelector client:visible />
    <HowItWorks />
    <Portabilidad />
    <BeProtected />
    <PlanSelector client:visible hideSimSelector />
    <DownloadApp />
    <FAQ />
    <CtaFinal />
  </main>
  <Footer transition:persist transition:name="panda-footer" />
</BaseLayout>
