---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import DynamicBanner from "../components/react/DynamicBanner";
import HeroBanner from "../components/react/HeroBanner";
import ServiceShell from "../components/astro/ServiceShell.astro";
import MobileStickyCta from "../components/astro/MobileStickyCta.astro";
import HBBSelector from "../components/react/HBBSelector";
import {
  organizationSchema,
  localBusinessSchema,
  serviceProductSchema,
} from "../lib/schema";
---

<BaseLayout
  title="Internet en Casa sin cables — desde $199/mes | Be Online"
  description="Internet en casa HBB 4G LTE sin instalación de cables, sin contratos. Llega a donde la fibra no llega. Activa tu router y conéctate hoy mismo."
  jsonLd={[
    organizationSchema(),
    localBusinessSchema(),
    serviceProductSchema("internet-hogar"),
  ]}
>
  <DynamicBanner
    client:idle
    transition:persist
    transition:name="panda-banner"
  />
  <Header transition:persist transition:name="panda-header" />

  <main transition:name="panda-main">
    <ServiceShell
      service="internet-hogar"
      serviceLabel="Internet en Casa"
      ctaTitle="Conexión sin cables, desde hoy"
      ctaSubtitle="Sin técnicos, sin instalaciones, sin esperas. Tu internet enchufado y funcionando en minutos."
    >
      <!-- HERO: banner CRM con fallback internet-casa-01 (familia + panda gamer en sala roja) -->
      <div slot="hero">
        <HeroBanner
          client:load
          section="internet-hogar"
          fallbackImage="/img/banners/services/internet-casa-01.webp"
          proofText="Internet en casa HBB · Sin instalación"
          headlineLine1="Internet en casa"
          headlineLine2="sin cables"
          description="Llega a donde la fibra no llega. Sin técnicos, sin obras, sin contratos. Solo enchufa y navega."
          primaryCta={{ label: "Ver planes HBB", href: "#hbb-planes" }}
          secondaryCta={{ label: "Verificar cobertura", href: "/cobertura" }}
        />
      </div>

      <!-- PRODUCT: planes HBB -->
      <div slot="product">
        <HBBSelector client:load />
      </div>

      <!-- CONTENT: bloques visuales (no muro de texto) manteniendo SEO H2s -->
      <div slot="content">
        <!-- ── BLOQUES 1+2 wrapper: bg compartido hbb-router-desk con parallax,
             igual que telefonia S5+S6 wrapper. Las 2 sections internas son
             transparentes y heredan el bg fijo. ───────────────────────────── -->
        <section
          class="relative overflow-hidden bg-cover bg-center bg-no-repeat md:bg-fixed"
          style="background-image: url(/img/banners/services/hbb-router-desk.webp);"
        >
          <!-- ── BLOQUE 1: Cómo funciona — 3 steps visuales ───────────────── -->
          <section
            class="relative py-14 md:py-20 overflow-hidden bg-transparent"
          >
            <div class="relative max-w-5xl mx-auto px-4">
              <div class="text-center mb-10">
                <p
                  class="font-poppins text-[11px] uppercase tracking-[0.18em] font-bold text-panda-red mb-2"
                >
                  Internet sin cables
                </p>
                <h2
                  class="font-unbounded text-2xl sm:text-3xl md:text-4xl font-bold text-panda-dark mb-3"
                >
                  Cómo funciona el internet HBB
                </h2>
                <p
                  class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto"
                >
                  HBB = <em>Home Broadband Wireless</em>. Internet de hogar
                  inalámbrico sobre la Red Compartida 4G LTE de Altán — el mismo
                  principio que tu celular, pero con equipo dedicado.
                </p>
              </div>

              <div
                class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-8 relative"
              >
                <!-- Línea conectora desktop -->
                <div
                  class="hidden md:block absolute top-7 left-[16%] right-[16%] h-px bg-gradient-to-r from-panda-red/30 via-panda-red/50 to-panda-red/30"
                  aria-hidden="true"
                >
                </div>

                <!-- Step 1 -->
                <div
                  class="relative bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-6 text-center"
                >
                  <div
                    class="relative inline-flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-panda-red to-panda-red-dark shadow-lg shadow-panda-red/30 mb-4 mx-auto"
                  >
                    <svg
                      class="w-6 h-6 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="font-unbounded text-base font-bold text-panda-dark mb-2"
                  >
                    Pides tu router
                  </h3>
                  <p
                    class="font-poppins text-[13px] text-panda-gray leading-relaxed"
                  >
                    Recibes el equipo en casa en 24-48h. Sin obra, sin técnicos,
                    sin agujeros en la pared.
                  </p>
                </div>

                <!-- Step 2 -->
                <div
                  class="relative bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-6 text-center"
                >
                  <div
                    class="relative inline-flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-panda-red to-panda-red-dark shadow-lg shadow-panda-red/30 mb-4 mx-auto"
                  >
                    <svg
                      class="w-6 h-6 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                    >
                  </div>
                  <h3
                    class="font-unbounded text-base font-bold text-panda-dark mb-2"
                  >
                    Lo enchufas
                  </h3>
                  <p
                    class="font-poppins text-[13px] text-panda-gray leading-relaxed"
                  >
                    Lo conectas a la corriente eléctrica y se enciende. El
                    router capta la señal 4G LTE Altán automáticamente.
                  </p>
                </div>

                <!-- Step 3 -->
                <div
                  class="relative bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-6 text-center"
                >
                  <div
                    class="relative inline-flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-panda-red to-panda-red-dark shadow-lg shadow-panda-red/30 mb-4 mx-auto"
                  >
                    <svg
                      class="w-6 h-6 text-white"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.858 15.355-5.858 21.213 0"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="font-unbounded text-base font-bold text-panda-dark mb-2"
                  >
                    WiFi listo
                  </h3>
                  <p
                    class="font-poppins text-[13px] text-panda-gray leading-relaxed"
                  >
                    Conectas tus dispositivos al WiFi del router. Antena de
                    mayor ganancia y estabilidad que un celular.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- ── BLOQUE 2: Comparativa HBB vs Fibra ──────────────────────── -->
          <section
            class="relative py-14 md:py-20 overflow-hidden bg-transparent"
          >
            <div class="relative max-w-5xl mx-auto px-4">
              <div class="text-center mb-10">
                <h2
                  class="font-unbounded text-2xl sm:text-3xl md:text-4xl font-bold text-panda-dark mb-3"
                >
                  Diferencia con fibra y cable
                </h2>
                <p
                  class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto"
                >
                  ¿Por qué cada vez más hogares eligen HBB en vez de esperar la
                  fibra?
                </p>
              </div>

              <!-- Mobile: 5 cards verticales con HBB vs Fibra side-by-side -->
              <div class="block md:hidden space-y-3">
                {
                  [
                    {
                      label: "Tiempo de instalación",
                      hbb: "Minutos",
                      fibra: "Días/semanas",
                    },
                    {
                      label: "Costo de instalación",
                      hbb: "$0",
                      fibra: "$500–$1,500",
                    },
                    {
                      label: "Mudanzas",
                      hbb: "Te sigue",
                      fibra: "Se queda",
                      hbbOk: true,
                      fibraX: true,
                    },
                    {
                      label: "Donde llega",
                      hbb: "Donde hay 4G LTE",
                      fibra: "Solo con fibra",
                    },
                    {
                      label: "Velocidad",
                      hbb: "HD + home office",
                      fibra: "Generalmente mayor",
                    },
                  ].map((row) => (
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                      <p class="font-poppins text-[12px] font-semibold text-panda-dark px-4 pt-3 pb-1.5">
                        {row.label}
                      </p>
                      <div class="grid grid-cols-2 gap-px bg-gray-100">
                        <div class="bg-panda-red/5 px-3 py-2.5 text-center">
                          <p class="font-unbounded text-[10px] font-bold text-panda-red uppercase tracking-wider mb-0.5">
                            HBB
                          </p>
                          <p class="font-poppins text-[12.5px] font-bold text-panda-dark leading-tight">
                            {row.hbbOk && (
                              <svg
                                class="w-3.5 h-3.5 text-panda-green inline mr-1"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M5 13l4 4L19 7"
                                />
                              </svg>
                            )}
                            {row.hbb}
                          </p>
                        </div>
                        <div class="bg-gray-50 px-3 py-2.5 text-center">
                          <p class="font-unbounded text-[10px] font-bold text-panda-gray uppercase tracking-wider mb-0.5">
                            Fibra
                          </p>
                          <p class="font-poppins text-[12.5px] text-panda-gray leading-tight">
                            {row.fibraX && (
                              <svg
                                class="w-3.5 h-3.5 text-gray-400 inline mr-1"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M6 18L18 6M6 6l12 12"
                                />
                              </svg>
                            )}
                            {row.fibra}
                          </p>
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>

              <!-- Desktop: tabla original -->
              <div
                class="hidden md:block bg-white rounded-2xl shadow-xl shadow-panda-dark/5 overflow-hidden border border-gray-100"
              >
                <div class="grid grid-cols-[1.3fr_1fr_1fr] gap-px bg-gray-100">
                  <!-- Header row -->
                  <div class="bg-white px-2 sm:px-4 py-3 sm:py-4"></div>
                  <div
                    class="bg-gradient-to-br from-panda-red to-panda-red-dark px-1.5 sm:px-4 py-3 sm:py-4 text-center"
                  >
                    <p
                      class="font-unbounded text-[11px] sm:text-sm font-bold text-white leading-tight"
                    >
                      HBB Be Online
                    </p>
                  </div>
                  <div
                    class="bg-gray-50 px-1.5 sm:px-4 py-3 sm:py-4 text-center"
                  >
                    <p
                      class="font-unbounded text-[11px] sm:text-sm font-bold text-panda-gray leading-tight"
                    >
                      Fibra / Cable
                    </p>
                  </div>

                  <!-- Row: Tiempo instalación -->
                  <div class="bg-white px-2 sm:px-4 py-2.5 sm:py-3.5">
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-semibold text-panda-dark leading-tight"
                    >
                      Tiempo instalación
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-bold text-panda-green leading-tight"
                    >
                      Minutos
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] text-panda-gray leading-tight"
                    >
                      Días/semanas
                    </p>
                  </div>

                  <!-- Row: Costo instalación -->
                  <div class="bg-white px-2 sm:px-4 py-2.5 sm:py-3.5">
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-semibold text-panda-dark leading-tight"
                    >
                      Costo instalación
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-bold text-panda-green leading-tight"
                    >
                      $0
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] text-panda-gray leading-tight"
                    >
                      $500–$1,500
                    </p>
                  </div>

                  <!-- Row: Mudanzas -->
                  <div class="bg-white px-2 sm:px-4 py-2.5 sm:py-3.5">
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-semibold text-panda-dark leading-tight"
                    >
                      Mudanzas
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 flex items-center justify-center gap-1"
                  >
                    <svg
                      class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-panda-green flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-bold text-panda-dark leading-tight"
                    >
                      Te sigue
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 flex items-center justify-center gap-1"
                  >
                    <svg
                      class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-gray-400 flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18L18 6M6 6l12 12"></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] text-panda-gray leading-tight"
                    >
                      Se queda
                    </p>
                  </div>

                  <!-- Row: Donde llega -->
                  <div class="bg-white px-2 sm:px-4 py-2.5 sm:py-3.5">
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-semibold text-panda-dark leading-tight"
                    >
                      Donde llega
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-bold text-panda-dark leading-tight"
                    >
                      Donde hay 4G
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] text-panda-gray leading-tight"
                    >
                      Solo con fibra
                    </p>
                  </div>

                  <!-- Row: Velocidad -->
                  <div class="bg-white px-2 sm:px-4 py-2.5 sm:py-3.5">
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-semibold text-panda-dark leading-tight"
                    >
                      Velocidad
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] font-bold text-panda-dark leading-tight"
                    >
                      HD + office
                    </p>
                  </div>
                  <div
                    class="bg-white px-1.5 sm:px-4 py-2.5 sm:py-3.5 text-center"
                  >
                    <p
                      class="font-poppins text-[11px] sm:text-[13px] text-panda-gray leading-tight"
                    >
                      Mayor
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </section><!-- /wrapper B1+B2 con bg compartido hbb-router-desk -->

        <!-- ── BLOQUE 3: Velocidades y consumo razonable — sin imagen, bg sólido -->
        <section class="relative py-14 md:py-20 overflow-hidden bg-white">
          <div class="relative max-w-5xl mx-auto px-4">
            <div class="text-center mb-10">
              <h2
                class="font-unbounded text-2xl sm:text-3xl md:text-4xl font-bold text-panda-dark mb-3"
              >
                ¿Qué plan necesitas?
              </h2>
              <p
                class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto"
              >
                Velocidades y consumo razonable según tu uso. Para una familia
                con 2-4 dispositivos, los planes intermedios y altos son
                ideales.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
              <!-- Uso ligero -->
              <div
                class="bg-gradient-to-br from-white to-panda-surface/50 rounded-2xl border border-gray-100 p-6"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 17v-2a4 4 0 014-4h4M19 17v-2m-2-4l2-2 2 2m-2-2v6"
                    ></path></svg
                  >
                </div>
                <h3
                  class="font-unbounded text-base font-bold text-panda-dark mb-1.5"
                >
                  Uso ligero
                </h3>
                <p
                  class="font-poppins text-[11px] text-panda-red uppercase tracking-wider font-semibold mb-3"
                >
                  1-2 personas
                </p>
                <ul class="space-y-1.5 mb-4">
                  <li
                    class="font-poppins text-[12.5px] text-panda-gray leading-snug"
                  >
                    Navegación web + redes sociales
                  </li>
                  <li
                    class="font-poppins text-[12.5px] text-panda-gray leading-snug"
                  >
                    Streaming SD ocasional
                  </li>
                  <li
                    class="font-poppins text-[12.5px] text-panda-gray leading-snug"
                  >
                    Email + WhatsApp
                  </li>
                </ul>
                <div class="pt-3 border-t border-gray-100">
                  <p
                    class="font-poppins text-[10px] text-panda-gray uppercase tracking-wider font-semibold mb-0.5"
                  >
                    Recomendado
                  </p>
                  <p class="font-unbounded text-sm font-bold text-panda-dark">
                    Plan básico HBB
                  </p>
                </div>
              </div>

              <!-- Uso familiar -->
              <div
                class="relative bg-white rounded-2xl border-2 border-panda-red shadow-xl shadow-panda-red/10 p-6 md:-translate-y-2"
              >
                <span
                  class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center px-3 py-1 rounded-full bg-panda-red text-white text-[10px] font-bold font-poppins uppercase tracking-wider shadow-lg"
                >
                  Popular
                </span>
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/15 flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                    ></path></svg
                  >
                </div>
                <h3
                  class="font-unbounded text-base font-bold text-panda-dark mb-1.5"
                >
                  Familiar
                </h3>
                <p
                  class="font-poppins text-[11px] text-panda-red uppercase tracking-wider font-semibold mb-3"
                >
                  2-4 personas
                </p>
                <ul class="space-y-1.5 mb-4">
                  <li
                    class="font-poppins text-[12.5px] text-panda-gray leading-snug"
                  >
                    Streaming HD Netflix/YouTube
                  </li>
                  <li
                    class="font-poppins text-[12.5px] text-panda-gray leading-snug"
                  >
                    Videollamadas Zoom/Meet
                  </li>
                  <li
                    class="font-poppins text-[12.5px] text-panda-gray leading-snug"
                  >
                    Home office + tareas escolares
                  </li>
                </ul>
                <div class="pt-3 border-t border-panda-red/15">
                  <p
                    class="font-poppins text-[10px] text-panda-gray uppercase tracking-wider font-semibold mb-0.5"
                  >
                    Recomendado
                  </p>
                  <p class="font-unbounded text-sm font-bold text-panda-dark">
                    Plan intermedio HBB
                  </p>
                </div>
              </div>

              <!-- Uso intensivo -->
              <div
                class="bg-gradient-to-br from-white to-panda-surface/50 rounded-2xl border border-gray-100 p-6"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-4"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
