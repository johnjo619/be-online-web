---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import DynamicBanner from "../components/react/DynamicBanner";
import HeroBanner from "../components/react/HeroBanner";
import ServiceShell from "../components/astro/ServiceShell.astro";
import MobileStickyCta from "../components/astro/MobileStickyCta.astro";
import MiFi from "../components/astro/MiFi.astro";
import {
  organizationSchema,
  localBusinessSchema,
  serviceProductSchema,
} from "../lib/schema";
---

<BaseLayout
  title="Internet Portátil MiFi — Wi-Fi para llevar | Be Online"
  description="Internet portátil MiFi Be Online: hasta 10 dispositivos conectados, batería todo el día, sin instalación. Ideal para viajes, autos y oficina móvil."
  jsonLd={[
    organizationSchema(),
    localBusinessSchema(),
    serviceProductSchema("mifi"),
  ]}
>
  <DynamicBanner
    client:idle
    transition:persist
    transition:name="panda-banner"
  />
  <Header transition:persist transition:name="panda-header" />

  <main transition:name="panda-main">
    <ServiceShell
      service="mifi"
      serviceLabel="Internet Portátil"
      ctaTitle="Wi-Fi en tu mochila, donde vayas"
      ctaSubtitle="Compacto, recargable, hasta 10 dispositivos conectados. Tu oficina y entretenimiento, móvil."
    >
      <!-- HERO: banner CRM con fallback mifi-01 (camping al atardecer) -->
      <div slot="hero">
        <HeroBanner
          client:load
          section="mifi"
          fallbackImage="/img/banners/services/mifi-01.webp"
          proofText="Internet portátil MiFi · Wi-Fi para llevar"
          headlineLine1="Wi-Fi en tu"
          headlineLine2="mochila"
          description="Cabe en la palma de tu mano. Comparte internet 4G LTE con hasta 10 dispositivos. Batería para todo el día."
          primaryCta={{ label: "Ver dispositivos", href: "#mifi" }}
          secondaryCta={{ label: "Verificar cobertura", href: "/cobertura" }}
        />
      </div>

      <!-- PRODUCT: MiFi card -->
      <div slot="product">
        <MiFi />
      </div>

      <!-- CONTENT: bloques visuales (no muro de texto) manteniendo SEO H2s -->
      <div slot="content">
        <!-- ── BLOQUES 1+2 wrapper: bg compartido mifi-device-red con parallax,
             igual que telefonia S5+S6 y HBB B1+B2 wrapper ──────────────────── -->
        <section
          class="relative overflow-hidden bg-cover bg-center bg-no-repeat md:bg-fixed"
          style="background-image: url(/img/banners/services/mifi-device-red.webp);"
        >
          <!-- ── BLOQUE 1: Qué es un MiFi y cuándo te conviene ─────────────── -->
          <section
            class="relative py-14 md:py-20 overflow-hidden bg-transparent"
          >
            <div class="relative max-w-5xl mx-auto px-4">
              <div class="text-center mb-10">
                <p
                  class="font-poppins text-[11px] uppercase tracking-[0.18em] font-bold text-panda-red mb-2"
                >
                  Wi-Fi para llevar
                </p>
                <h2
                  class="font-unbounded text-2xl sm:text-3xl md:text-4xl font-bold text-panda-dark mb-3"
                >
                  Qué es un MiFi y cuándo te conviene
                </h2>
                <p
                  class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto"
                >
                  Un <strong>MiFi</strong> (también llamado <em
                    >hotspot móvil</em
                  >) es un dispositivo del tamaño de un mouse que recibe señal
                  4G LTE y la convierte en Wi-Fi. A diferencia del hotspot del
                  celular, no consume tu batería ni interrumpe llamadas.
                </p>
              </div>

              <!-- 4 user personas -->
              <div
                class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto"
              >
                <div
                  class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow"
                >
                  <div
                    class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3 mx-auto"
                  >
                    <svg
                      class="w-5 h-5 text-panda-red"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="font-unbounded text-sm font-bold text-panda-dark mb-1"
                  >
                    Viajeros
                  </h3>
                  <p
                    class="font-poppins text-[12px] text-panda-gray leading-snug"
                  >
                    Evita Wi-Fi caro de hotel
                  </p>
                </div>

                <div
                  class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow"
                >
                  <div
                    class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3 mx-auto"
                  >
                    <svg
                      class="w-5 h-5 text-panda-red"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 17v-2a4 4 0 014-4h4M19 17v-2m-2-4l2-2 2 2m-2-2v6M3 7h18M3 7l3-3m-3 3l3 3"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="font-unbounded text-sm font-bold text-panda-dark mb-1"
                  >
                    Remotos
                  </h3>
                  <p
                    class="font-poppins text-[12px] text-panda-gray leading-snug"
                  >
                    Trabaja desde cualquier lugar
                  </p>
                </div>

                <div
                  class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow"
                >
                  <div
                    class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3 mx-auto"
                  >
                    <svg
                      class="w-5 h-5 text-panda-red"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="font-unbounded text-sm font-bold text-panda-dark mb-1"
                  >
                    Eventos
                  </h3>
                  <p
                    class="font-poppins text-[12px] text-panda-gray leading-snug"
                  >
                    Pop-ups, ferias, expos
                  </p>
                </div>

                <div
                  class="bg-white rounded-2xl border border-gray-100 p-5 text-center hover:shadow-md transition-shadow"
                >
                  <div
                    class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3 mx-auto"
                  >
                    <svg
                      class="w-5 h-5 text-panda-red"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                      ></path></svg
                    >
                  </div>
                  <h3
                    class="font-unbounded text-sm font-bold text-panda-dark mb-1"
                  >
                    Respaldo casa
                  </h3>
                  <p
                    class="font-poppins text-[12px] text-panda-gray leading-snug"
                  >
                    Cuando se cae la fibra
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- ── BLOQUE 2: Especificaciones del dispositivo ─────────────── -->
          <section
            class="relative py-14 md:py-20 overflow-hidden bg-transparent"
          >
            <div class="relative max-w-5xl mx-auto px-4">
              <div class="text-center mb-10">
                <h2
                  class="font-unbounded text-2xl sm:text-3xl md:text-4xl font-bold text-panda-dark mb-3"
                >
                  Especificaciones del dispositivo
                </h2>
                <p
                  class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto"
                >
                  Compacto, recargable y listo en segundos. Esto es lo que
                  llevas en tu bolsillo.
                </p>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
                <div class="bg-white rounded-xl p-5 shadow-sm">
                  <div class="flex items-center gap-2 mb-2">
                    <svg
                      class="w-4 h-4 text-panda-red flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                      ></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] text-panda-gray uppercase tracking-wider font-semibold"
                    >
                      Conexiones
                    </p>
                  </div>
                  <p
                    class="font-unbounded text-base font-bold text-panda-dark leading-tight"
                  >
                    10 dispositivos
                  </p>
                  <p class="font-poppins text-[12px] text-panda-gray mt-1">
                    Simultáneos por Wi-Fi
                  </p>
                </div>

                <div class="bg-white rounded-xl p-5 shadow-sm">
                  <div class="flex items-center gap-2 mb-2">
                    <svg
                      class="w-4 h-4 text-panda-red flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 18H3a1 1 0 01-1-1V7a1 1 0 011-1h2m14 12h2a1 1 0 001-1V7a1 1 0 00-1-1h-2M5 6v12m14-12v12M9 7v10m6-10v10"
                      ></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] text-panda-gray uppercase tracking-wider font-semibold"
                    >
                      Batería
                    </p>
                  </div>
                  <p
                    class="font-unbounded text-base font-bold text-panda-dark leading-tight"
                  >
                    12 horas
                  </p>
                  <p class="font-poppins text-[12px] text-panda-gray mt-1">
                    Uso continuo
                  </p>
                </div>

                <div class="bg-white rounded-xl p-5 shadow-sm">
                  <div class="flex items-center gap-2 mb-2">
                    <svg
                      class="w-4 h-4 text-panda-red flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] text-panda-gray uppercase tracking-wider font-semibold"
                    >
                      Recarga
                    </p>
                  </div>
                  <p
                    class="font-unbounded text-base font-bold text-panda-dark leading-tight"
                  >
                    USB-C
                  </p>
                  <p class="font-poppins text-[12px] text-panda-gray mt-1">
                    Totalmente recargable
                  </p>
                </div>

                <div class="bg-white rounded-xl p-5 shadow-sm">
                  <div class="flex items-center gap-2 mb-2">
                    <svg
                      class="w-4 h-4 text-panda-red flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.858 15.355-5.858 21.213 0"
                      ></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] text-panda-gray uppercase tracking-wider font-semibold"
                    >
                      Tecnología
                    </p>
                  </div>
                  <p
                    class="font-unbounded text-base font-bold text-panda-dark leading-tight"
                  >
                    4G LTE
                  </p>
                  <p class="font-poppins text-[12px] text-panda-gray mt-1">
                    Red Compartida Altán
                  </p>
                </div>

                <div class="bg-white rounded-xl p-5 shadow-sm">
                  <div class="flex items-center gap-2 mb-2">
                    <svg
                      class="w-4 h-4 text-panda-red flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                      ></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] text-panda-gray uppercase tracking-wider font-semibold"
                    >
                      Tamaño
                    </p>
                  </div>
                  <p
                    class="font-unbounded text-base font-bold text-panda-dark leading-tight"
                  >
                    Bolsillo
                  </p>
                  <p class="font-poppins text-[12px] text-panda-gray mt-1">
                    Cabe en la mano
                  </p>
                </div>

                <div class="bg-white rounded-xl p-5 shadow-sm">
                  <div class="flex items-center gap-2 mb-2">
                    <svg
                      class="w-4 h-4 text-panda-red flex-shrink-0"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5 13l4 4L19 7"></path></svg
                    >
                    <p
                      class="font-poppins text-[11px] text-panda-gray uppercase tracking-wider font-semibold"
                    >
                      Activación
                    </p>
                  </div>
                  <p
                    class="font-unbounded text-base font-bold text-panda-dark leading-tight"
                  >
                    Instantánea
                  </p>
                  <p class="font-poppins text-[12px] text-panda-gray mt-1">
                    Insertas SIM, listo
                  </p>
                </div>
              </div>
            </div>
          </section>
        </section><!-- /wrapper B1+B2 con bg compartido mifi-airport -->

        <!-- ── BLOQUE 3: Casos de uso reales ───────────────────────────── -->
        <section
          class="relative py-14 md:py-20 overflow-hidden bg-cover bg-center bg-no-repeat md:bg-fixed"
          style="background-image: url(/img/banners/services/mifi-01.webp);"
        >
          <div class="relative max-w-5xl mx-auto px-4">
            <div class="text-center mb-10">
              <h2
                class="font-unbounded text-2xl sm:text-3xl md:text-4xl font-bold text-panda-dark mb-3"
              >
                Casos de uso reales
              </h2>
              <p
                class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto"
              >
                MiFi Be Online donde quieras, cuando quieras.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
              <div
                class="bg-gradient-to-br from-panda-surface to-white rounded-2xl p-5 border border-gray-100 hover:shadow-lg hover:-translate-y-0.5 transition-all"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                    ></path></svg
                  >
                </div>
                <h3
                  class="font-unbounded text-sm font-bold text-panda-dark mb-1.5"
                >
                  Viajes
                </h3>
                <p
                  class="font-poppins text-[12px] text-panda-gray leading-snug"
                >
                  Wi-Fi caro de hotel o roaming, fuera
                </p>
              </div>

              <div
                class="bg-gradient-to-br from-panda-surface to-white rounded-2xl p-5 border border-gray-100 hover:shadow-lg hover:-translate-y-0.5 transition-all"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    ></path></svg
                  >
                </div>
                <h3
                  class="font-unbounded text-sm font-bold text-panda-dark mb-1.5"
                >
                  Oficina móvil
                </h3>
                <p
                  class="font-poppins text-[12px] text-panda-gray leading-snug"
                >
                  Vendedores, agentes, campo
                </p>
              </div>

              <div
                class="bg-gradient-to-br from-panda-surface to-white rounded-2xl p-5 border border-gray-100 hover:shadow-lg hover:-translate-y-0.5 transition-all"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                    ></path></svg
                  >
                </div>
                <h3
                  class="font-unbounded text-sm font-bold text-panda-dark mb-1.5"
                >
                  Autos / RVs
                </h3>
                <p
                  class="font-poppins text-[12px] text-panda-gray leading-snug"
                >
                  Tablets, videollamadas en trayecto
                </p>
              </div>

              <div
                class="bg-gradient-to-br from-panda-surface to-white rounded-2xl p-5 border border-gray-100 hover:shadow-lg hover:-translate-y-0.5 transition-all"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                    ></path></svg
                  >
                </div>
                <h3
                  class="font-unbounded text-sm font-bold text-panda-dark mb-1.5"
                >
                  Eventos / pop-ups
                </h3>
                <p
                  class="font-poppins text-[12px] text-panda-gray leading-snug"
                >
                  Ferias, ventas sin infra fija
                </p>
              </div>

              <div
                class="bg-gradient-to-br from-panda-surface to-white rounded-2xl p-5 border border-gray-100 hover:shadow-lg hover:-translate-y-0.5 transition-all"
              >
                <div
                  class="w-10 h-10 rounded-xl bg-panda-red/10 flex items-center justify-center mb-3"
                >
                  <svg
                    class="w-5 h-5 text-panda-red"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                    ></path></svg
                  >
                </div>
                <h3
                  class="font-unbounded text-sm font-bold text-panda-dark mb-1.5"
                >
                  Respaldo casa
                </h3>
                <p
                  class="font-poppins text-[12px] text-panda-gray leading-snug"
                >
                  Cuando se cae la fibra
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- ── BLOQUE 4: Cuánto dura la batería y cuántos dispositivos ── -->
        <section
          class="relative py-14 md:py-20 overflow-hidden bg-cover bg-right bg-no-repeat md:bg-fixed"
          style="background-image: url(/img/banners/services/mifi-02.webp);"
        >
          <div class="relative max-w-5xl mx-auto px-4">
            <div class="text-center mb-10">
              <h2
                class="font-unbounded text-2xl sm:text-3xl md:text-4xl font-bold text-panda-dark mb-3"
              >
                Batería y rendimiento real
              </h2>
              <p
                class="font-poppins text-sm sm:text-base text-panda-gray max-w-2xl mx-auto"
              >
                Cuánto dura según tu uso, y opción para mantenerlo enchufado en
                escritorio o auto.
              </p>
            </div>

            <div
              class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-4xl mx-auto"
            >
              <!-- Uso normal -->
              <div
                class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100"
              >
                <div class="flex items-center gap-2 mb-4">
                  <span
                    class="font-poppins text-[10px] uppercase tracking-wider font-semibold text-panda-gray"
                    >Uso normal</span
                  >
                  <span
                    class="px-2 py-0.5 rounded-full bg-panda-green/15 text-panda-green text-[10px] font-poppins font-bold"
                    >12h+</span
                  >
                </div>
