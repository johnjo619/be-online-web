---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import DynamicBanner from "../components/react/DynamicBanner";
import ActivationWizard from "../components/react/wizard/ActivationWizard";
import Footer from "../components/astro/Footer.astro";
import { organizationSchema } from "../lib/schema";
import astronauta from "@/assets/images/astronauta2.webp";

const jsonLd = [
  organizationSchema(),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: "https://beonline.celink.mx/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Activa y Recarga",
        item: "https://beonline.celink.mx/recarga/",
      },
    ],
  },
];
---

<BaseLayout
  title="Activa y Recarga Be Online — Activa tu SIM o recarga saldo en minutos"
  description="Activa tu línea Be Online o recarga saldo en un solo lugar. Ingresa tu número, elige tu paquete y paga con tarjeta, PayPal, MercadoPago u OXXO. Sin contratos."
  jsonLd={jsonLd}
>
  <DynamicBanner client:idle />
  <Header />

  <main>
    <section class="bg-[#1a1e29] relative overflow-x-clip">
      <div class="w-full h-2 bg-[#fccd4d]"></div>

      <div class="mx-auto px-4 max-w-5xl py-12 sm:py-16">
        {/* Encabezado con branding de marca — mismo patrón que HowItWorks */}
        <div class="flex items-center justify-between gap-6 mb-10">
          <div>
            <h1
              class="font-unbounded text-2xl sm:text-4xl font-extrabold text-white tracking-tight"
            >
              Activa y recarga tu línea
            </h1>
            <p class="font-poppins text-[#fccd4d] font-semibold mt-2 text-sm sm:text-base">
              Hasta el infinito y más acá
            </p>
            <p class="font-poppins text-white/70 text-sm mt-3 max-w-md">
              El mismo lugar para activar tu SIM por primera vez o recargar
              saldo: ingresa tu número, elige tu paquete y paga como prefieras.
            </p>
          </div>
          <div
            class="shrink-0 w-24 sm:w-36 md:w-44 animate-bounce"
            style="animation-duration: 5s;"
          >
            <img
              src={astronauta.src}
              alt="Astronauta Be Online con celular"
              class="w-full h-auto drop-shadow-[0_15px_25px_rgba(0,0,0,0.6)]"
              loading="eager"
            />
          </div>
        </div>

        <div class="bg-[#f8fafc] rounded-3xl p-6 sm:p-10 shadow-xl">
          <ActivationWizard client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
