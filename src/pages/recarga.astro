---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import DynamicBanner from "../components/react/DynamicBanner";
import ActivationWizard from "../components/react/wizard/ActivationWizard";
import Footer from "../components/astro/Footer.astro";
import { organizationSchema } from "../lib/schema";
import astronautaImagen from "@/assets/images/astronauta6.png";

const jsonLd = [
  organizationSchema(),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: "https://beonline.celink.mx/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Activa y Recarga",
        item: "https://beonline.celink.mx/recarga/",
      },
    ],
  },
];
---

<BaseLayout
  title="Activa y Recarga Be Online — Activa tu SIM o recarga saldo en minutos"
  description="Activa tu línea Be Online o recarga saldo en un solo lugar. Ingresa tu número, elige tu paquete y paga con tarjeta, PayPal, MercadoPago u OXXO. Sin contratos."
  jsonLd={jsonLd}
>
  <DynamicBanner client:idle />
  <Header />

  <main class="pt-[72px]">
    {/* Mismo layout que las páginas anteriores de activa/recarga: título
        uppercase centrado, tarjeta blanca redondeada y el astronauta de
        bienvenida asomando en la esquina superior derecha. */}
    <section class="bg-[#1a1e29] pt-12 pb-16 px-4">
      <h1
        class="text-3xl md:text-[40px] font-black text-white text-center uppercase tracking-wide mb-16 md:pr-40"
      >
        Activa y recarga tu línea
      </h1>

      <div
        class="max-w-[850px] mx-auto bg-white rounded-[2.5rem] p-8 md:px-16 md:py-12 relative shadow-2xl"
      >
        {/* Astronauta de bienvenida (branding de marca): asoma sobre la
            esquina de la tarjeta sin tapar el stepper ni los textos. */}
        <div
          class="absolute -top-32 -right-2 hidden md:block w-44 z-20"
        >
          <img
            src={astronautaImagen.src}
            alt="Bienvenido a Be Online"
            class="w-full drop-shadow-xl"
          />
        </div>

        <ActivationWizard client:visible />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
