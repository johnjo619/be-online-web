---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import DynamicBanner from "../components/react/DynamicBanner";
import ActivationWizard from "../components/react/wizard/ActivationWizard";
import Footer from "../components/astro/Footer.astro";
import { organizationSchema } from "../lib/schema";

const jsonLd = [
  organizationSchema(),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: "https://beonline.celink.mx/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Recarga",
        item: "https://beonline.celink.mx/recarga/",
      },
    ],
  },
];
---

<BaseLayout
  title="Recarga Be Online — Recarga saldo o activa tu línea en minutos"
  description="Recarga tu línea Be Online o actívala por primera vez. Ingresa tu número, elige tu paquete y paga con tarjeta, PayPal, MercadoPago u OXXO. Sin contratos."
  jsonLd={jsonLd}
>
  <DynamicBanner client:idle />
  <Header />

  <main>
    <section class="py-12 sm:py-16 bg-[#1a1e29]">
      <div class="mx-auto px-4 max-w-5xl">
        <h1
          class="font-unbounded text-2xl sm:text-3xl font-bold text-white text-center mb-8"
        >
          Recarga o activa tu línea
        </h1>
        <div class="bg-[#f8fafc] rounded-3xl p-6 sm:p-10 shadow-xl">
          <ActivationWizard client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
